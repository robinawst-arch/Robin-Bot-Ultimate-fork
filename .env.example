# =============================================
# Robin Bot Environment Variables
# =============================================
# Copy this file to .env and fill in your API keys

# OpenAI API (for /ai command)
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# Llama API (for /llama command)
LLAMA_API_KEY=your-llama-api-key-here
LLAMA_MODEL=llama-4-70b

# ElevenLabs Voice API (for /voice command)
ELEVEN_API_KEY=your-elevenlabs-api-key-here
ELEVEN_VOICE_GIRL=your-girl-voice-id
ELEVEN_VOICE_BOY=your-boy-voice-id

# Bot Owner ID (for /relation command)
ROBIN_ID=100091520325159

# AI Cooldown (in seconds, default: 10)
AI_COOLDOWN=10

# Port for keep-alive server (default: 3000)
PORT=3000
