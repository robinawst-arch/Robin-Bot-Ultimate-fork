const axios = require("axios");
const fs = require("fs");
const path = require("path");
const yts = require("yt-search");

module.exports = {
  config: {
    name: "video",
    version: "1.2.0",
    credits: "Robin-Bot",
    countDown: 5,
    hasPermssion: 0,
    description: "Download video, audio from YouTube",
    category: "media",
    commandCategory: "media",
    usePrefix: true,
    prefix: true,
    usages:
      " {pn} [video|-v] [<video name>]\n" +
      " {pn} [audio|-a] [<audio name>]\n" +
      "Example:\n" +
      "{pn} -v chipi chipi\n" +
      "{pn} -a despacito",
  },

  run: async ({ api, args, event }) => {
    const { threadID, messageID, senderID } = event;

    let action = args[0] ? args[0].toLowerCase() : "-v";

    if (!["-v", "video", "mp4", "-a", "audio", "mp3"].includes(action)) {
      args.unshift("-v");
      action = "-v";
    }

    args.shift();
    const keyWord = args.join(" ");

    if (!keyWord) {
      return api.sendMessage(
        "❌ Please provide a search keyword.\n\nExample:\n/video -v song name\n/video -a song name",
        threadID,
        messageID
      );
    }

    try {
      // Search for videos using yt-search
      const searchResult = await yts(keyWord);

      if (!searchResult.videos || searchResult.videos.length === 0) {
        return api.sendMessage(
          `⭕ No results for keyword: ${keyWord}`,
          threadID,
          messageID
        );
      }

      const results = searchResult.videos.slice(0, 6).map((v) => ({
        id: v.videoId,
        title: v.title,
        time: v.timestamp,
        thumbnail: v.thumbnail,
        channel: { name: v.author.name },
      }));

      let msg = "🎬 Select a video:\n\n";
      const thumbnails = [];
      let i = 1;

      for (const info of results) {
        const thumbPath = path.join(
          __dirname,
          "cache",
          `thumb_${Date.now()}_${i}.jpg`
        );
        thumbnails.push(await streamImage(info.thumbnail, thumbPath));
        msg += `${i++}. ${info.title}\nTime: ${info.time}\nChannel: ${info.channel.name}\n\n`;
      }

      api.sendMessage(
        {
          body: msg + "👉 Reply to this message with a number to select.",
          attachment: thumbnails,
        },
        threadID,
        (err, info) => {
          if (err) return console.error(err);
          if (info && info.messageID) {
            global.client.handleReply.set(info.messageID, {
              name: module.exports.config.name,
              messageID: info.messageID,
              author: senderID,
              result: results,
              action,
            });
          }
        },
        messageID
      );
    } catch (err) {
      console.error("Video search error:", err.message);
      return api.sendMessage(
        "❌ An error occurred while searching. Please try again later.",
        threadID,
        messageID
      );
    }
  },

  handleReply: async ({ event, api, handleReply }) => {
    const { threadID, messageID, senderID, body } = event;

    if (senderID !== handleReply.author) return;
    const { result, action } = handleReply;
    const choice = parseInt(body);

    if (isNaN(choice) || choice <= 0 || choice > result.length) {
      return api.sendMessage(
        "❌ Invalid number. Please reply with a valid number.",
        threadID,
        messageID
      );
    }

    const selectedVideo = result[choice - 1];
    const videoID = selectedVideo.id;

    try {
      await api.unsendMessage(handleReply.messageID);
    } catch (e) {
      console.error("Unsend failed:", e);
    }

    const format = ["-v", "video", "mp4"].includes(action) ? "mp4" : "mp3";

    try {
      api.sendMessage("⏳ Downloading... Please wait.", threadID, messageID);

      const filePath = path.join(
        __dirname,
        "cache",
        `ytb_${format}_${Date.now()}.${format}`
      );
      
      let downloadUrl = null;
      let title = "Video";
      
      // Try multiple APIs for reliability
      try {
        const api1 = await axios.get(`https://api.ryzendesu.vip/api/downloader/ytdl?url=https://youtube.com/watch?v=${videoID}`);
        if (api1.data) {
          downloadUrl = format === 'mp4' ? api1.data.videoUrl : api1.data.audioUrl;
          title = api1.data.title || title;
        }
      } catch (e1) {
        console.log("API 1 failed, trying API 2...");
        try {
          const api2 = await axios.get(`https://api-nodex.vercel.app/youtube/download?url=https://youtube.com/watch?v=${videoID}`);
          if (api2.data) {
            downloadUrl = format === 'mp4' ? api2.data.video : api2.data.audio;
            title = api2.data.title || title;
          }
        } catch (e2) {
          return api.sendMessage(
            "❌ All download APIs failed. Try another video.",
            threadID,
            messageID
          );
        }
      }

      if (!downloadUrl) {
        return api.sendMessage(
          "❌ Download link not available. Try another video.",
          threadID,
          messageID
        );
      }

      await downloadFile(downloadUrl, filePath);

      await api.sendMessage(
        {
          body: `✅ Downloaded!\n\n📝 Title: ${title}\n🎵 Format: ${format.toUpperCase()}`,
          attachment: fs.createReadStream(filePath),
        },
        threadID,
        () => fs.unlinkSync(filePath),
        messageID
      );
    } catch (e) {
      console.error("Download error:", e.message);
      return api.sendMessage(
        "❌ Failed to download. Please try another video.",
        threadID,
        messageID
      );
    }
  },
};

async function downloadFile(url, pathName) {
  try {
    const res = await axios.get(url, { responseType: "arraybuffer" });
    fs.writeFileSync(pathName, Buffer.from(res.data));
  } catch (err) {
    throw err;
  }
}

async function streamImage(url, pathName) {
  try {
    const response = await axios.get(url, { responseType: "stream" });
    const writer = fs.createWriteStream(pathName);
    response.data.pipe(writer);
    await new Promise((r) => writer.on("finish", r));
    return fs.createReadStream(pathName);
  } catch (err) {
    throw err;
  }
}

  run: async ({ api, args, event }) => {
    const { threadID, messageID, senderID } = event;

    let action = args[0] ? args[0].toLowerCase() : "-v";

    if (!["-v", "video", "mp4", "-a", "audio", "mp3"].includes(action)) {
      args.unshift("-v");
      action = "-v";
    }

    args.shift();
    const keyWord = args.join(" ");

    if (!keyWord) {
      return api.sendMessage(
        "❌ Please provide a search keyword.\n\nExample:\n/video -v song name\n/video -a song name",
        threadID,
        messageID
      );
    }

    try {
      // Search for videos using yt-search
      const searchResult = await yts(keyWord);

      if (!searchResult.videos || searchResult.videos.length === 0) {
        return api.sendMessage(
          `⭕ No results for keyword: ${keyWord}`,
          threadID,
          messageID
        );
      }

      const results = searchResult.videos.slice(0, 6).map((v) => ({
        id: v.videoId,
        title: v.title,
        time: v.timestamp,
        thumbnail: v.thumbnail,
        channel: { name: v.author.name },
      }));
      let msg = "";
      const thumbnails = [];
      let i = 1;

      for (const info of results) {
        thumbnails.push(streamImage(info.thumbnail, `thumbnail_${i}.jpg`));
        msg += `${i++}. ${info.title}\nTime: ${info.time}\nChannel: ${
          info.channel.name
        }\n\n`;
      }

      api.sendMessage(
        {
          body: msg + "👉 Reply to this message with a number to select.",
          attachment: await Promise.all(thumbnails),
        },
        threadID,
        (err, info) => {
          if (err) return console.error(err);
          if (info && info.messageID) {
            global.client.handleReply.set(info.messageID, {
              name: module.exports.config.name,
              messageID: info.messageID,
              author: senderID,
              result: results,
              action,
            });
          }
        },
        messageID
      );
    } catch (err) {
      console.error("Video search error:", err.message);
      return api.sendMessage(
        "❌ An error occurred while searching. Please try again later.",
        threadID,
        messageID
      );
    }
  },

  handleReply: async ({ event, api, handleReply }) => {
    const { threadID, messageID, senderID, body } = event;

    if (senderID !== handleReply.author) return;
    const { result, action } = handleReply;
    const choice = parseInt(body);

    if (isNaN(choice) || choice <= 0 || choice > result.length) {
      return api.sendMessage(
        "❌ Invalid number. Please reply with a valid number.",
        threadID,
        messageID
      );
    }

    const selectedVideo = result[choice - 1];
    const videoID = selectedVideo.id;

    try {
      await api.unsendMessage(handleReply.messageID);
    } catch (e) {
      console.error("Unsend failed:", e);
    }

    const format = ["-v", "video", "mp4"].includes(action) ? "mp4" : "mp3";

    try {
      api.sendMessage("⏳ Downloading... Please wait.", threadID, messageID);

      const path = `ytb_${format}_${videoID}.${format}`;

      // Use working API
      const apiUrl = `https://api.giftedtech.my.id/api/download/yt${
        format === "mp4" ? "mp4" : "mp3"
      }?apikey=gifted&url=https://youtube.com/watch?v=${videoID}`;
      const { data } = await axios.get(apiUrl);

      if (!data.result || !data.result.download_url) {
        return api.sendMessage(
          "❌ Download link not available. Try another video.",
          threadID,
          messageID
        );
      }

      await api.sendMessage(
        {
          body: `✅ Downloaded!\n\n📝 Title: ${
            data.result.title || "Video"
          }\n🎵 Format: ${format.toUpperCase()}`,
          attachment: await downloadFile(data.result.download_url, path),
        },
        threadID,
        () => fs.unlinkSync(path),
        messageID
      );
    } catch (e) {
      console.error("Download error:", e.message);
      return api.sendMessage(
        "❌ Failed to download. Please try another video.",
        threadID,
        messageID
      );
    }
  },
};

async function downloadFile(url, pathName) {
  try {
    const res = await axios.get(url, { responseType: "arraybuffer" });
    fs.writeFileSync(pathName, Buffer.from(res.data));
    return fs.createReadStream(pathName);
  } catch (err) {
    throw err;
  }
}

async function streamImage(url, pathName) {
  try {
    const response = await axios.get(url, { responseType: "stream" });
    response.data.path = pathName;
    return response.data;
  } catch (err) {
    throw err;
  }
}
